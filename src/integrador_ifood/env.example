# --- Financial ---
IFOOD_FIN_CLIENT_ID=
IFOOD_FIN_CLIENT_SECRET=
IFOOD_FIN_LOJAS=
IFOOD_FIN_HOMOLOGACAO=1
# Endereco das APIs do Financial (NAO e a rota do painel).
# Vazio = usa o padrao do codigo:
#   /financial/v3.0/merchants/{merchantId}/{recurso}
# Descubra o certo com: python fin_testar.py
# (este modelo trazia /financeiro e /financeiro/conciliacao, que sao
#  caminhos do painel Flask e fariam a chamada ir para o lugar errado)
IFOOD_FIN_ROTA=
IFOOD_FIN_ROTA_CONC=
